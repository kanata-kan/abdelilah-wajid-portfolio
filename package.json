{
  "name": "abdelilah-wajid-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": { "node": "24.20.0" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "check:content": "node scripts/verify-docs.mjs && node scripts/verify-runtime-assets.mjs",
    "test": "node --test tests/foundation.test.ts",
    "test:smoke": "node scripts/smoke.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm check:content && pnpm test && pnpm build && pnpm test:smoke"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "typescript": "6.0.3"
  }
}
